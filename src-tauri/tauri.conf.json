{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Megaball Neo",
  "version": "1.0.0",
  "identifier": "com.garethwright.megaball",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Megaball Neo",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "backgroundColor": "#040a11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi"
    ],
    "category": "ArcadeGame",
    "shortDescription": "Megaball Neo",
    "longDescription": "A modern tribute to Ed & Al Mackey's Amiga classic Megaball, with Rive animation, a rotating WebGL Earth and endless procedural rounds.",
    "copyright": "Developed by Loxy. Original Megaball © Ed & Al Mackey; Megaball Neo is an unofficial tribute.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "publisher": "Loxy"
  }
}
